{
  "name": "@gbesse/jev-marches",
  "version": "0.3.2",
  "description": "Trie les avis de marchés publics français selon les capacités déclarées d’une entreprise.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.mts",
      "import": "./src/index.mjs"
    },
    "./jev": {
      "import": "./src/jev.mjs",
      "types": "./src/jev.d.mts"
    }
  },
  "bin": {
    "jev-marches": "./bin/jev-marches.mjs"
  },
  "scripts": {
    "check": "node scripts/check.mjs",
    "typecheck": "tsc --noEmit --strict --target ES2022 --module NodeNext docs/public-api-types.mts",
    "test": "node --test",
    "demo": "node examples/demo.mjs && node examples/cas-limite.mjs && node examples/radar.mjs",
    "demo:principal": "node examples/demo.mjs",
    "demo:limite": "node examples/cas-limite.mjs",
    "demo:parcours": "node examples/parcours-comparatif.mjs",
    "benchmark": "node scripts/benchmark-radar.mjs",
    "benchmark:offline": "node scripts/benchmark-radar.mjs --offline"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gbesse/jev-marches.git"
  },
  "keywords": [
    "jev",
    "typesafe-ai",
    "france",
    "decision-automation"
  ],
  "files": [
    "src",
    "bin",
    "benchmarks",
    "docs",
    "examples",
    "scripts"
  ]
}
